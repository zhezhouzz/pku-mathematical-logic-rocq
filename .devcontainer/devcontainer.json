{
  "name": "PKU Mathematical Logic (Rocq)",
  "image": "zhouzhe956/pku-mathematical-logic-rocq:rocq-9.1.1",
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/rocq/project,type=bind,consistency=cached",
  "workspaceFolder": "/home/rocq/project",
  "remoteUser": "rocq",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "rocq-prover.vsrocq"
      ],
      "settings": {
        "vsrocq.path": "/home/rocq/bin/vsrocqtop"
      }
    }
  },
  "postStartCommand": "make devcontainer-ide"
}
